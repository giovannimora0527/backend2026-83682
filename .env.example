# Copiar como .env y completar. El archivo .env nunca se sube a Git.
DB_URL=jdbc:mysql://localhost:3306/clinica?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=America/Bogota
DB_USER=
DB_PASSWORD=
# Base64 de al menos 64 bytes aleatorios. Ejemplo: openssl rand -base64 64 | tr -d '
'
JWT_SECRET=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
CORS_ORIGINS=http://localhost:4200,http://localhost

# ---- Docker Compose (todo es opcional; entre parentesis, el valor por defecto) ----
# Carpeta del frontend (../frontend26-83682)
#FRONTEND_PATH=../frontend26-83682
# Contrasena de la base dentro de Docker
#DOCKER_DB_PASSWORD=
# Clave JWT dentro de Docker; vacia, se genera sola
#DOCKER_JWT_SECRET=
#DOCKER_CORS_ORIGINS=http://localhost:4200,http://localhost
# Puertos en el equipo (4200, 8080, 8025 y 3307)
#FRONTEND_PORT=4200
#BACKEND_PORT=8080
#MAILPIT_PORT=8025
#DB_PORT_HOST=3307
